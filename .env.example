# COTI testnet only. Store this as a regular single-link file in a dedicated
# directory outside the repository, set CIPHERDEX_FUNDED_ENV_FILE to its absolute
# path, and run `npm run secure:funded-env`. Never commit funded credentials.
COTI_TESTNET_RPC_URL=https://testnet.coti.io/rpc
COTI_TESTNET_GAS_LIMIT=30000000
COTI_BEST_EXECUTION_GAS_LIMIT=60000000
COTI_TESTNET_PRIVATE_KEY=
# AES key for the funded, already-onboarded testnet account. Never commit it.
COTI_AES_KEY=
# A separate funded/onboarded LP account used to prove aggregate multi-LP behavior.
COTI_SECOND_LP_PRIVATE_KEY=
COTI_SECOND_LP_AES_KEY=
# A distinct onboarded test identity used for encrypted quote requests and as
# the launch-review signer in the isolated launchpad validation runner.
COTI_QUOTE_PRIVATE_KEY=
COTI_QUOTE_AES_KEY=
# Dedicated immutable beneficiary for the shared CipherDEX fee vault.
CIPHERDEX_FEE_BENEFICIARY=
# Dedicated immutable launch-review authority. Must be distinct from pool creators.
CIPHERDEX_LAUNCH_AUTHORITY=
# Required immutable public deployment record path. Replace <full-git-commit>
# with the exact clean 40-character HEAD that will be deployed.
COTI_DEPLOYMENT_RECORD=

# Canonical reviewed deployment addresses. All funded runners require the
# factory and vault even when a scenario intentionally deploys a disposable
# stack, because the tracked record binds the deployed protocol source.
COTI_FACTORY=
COTI_FEE_VAULT=
COTI_BEST_EXECUTION_ROUTER=
CIPHERDEX_CONFIGURED_COMPATIBILITY_PROOF=
CIPHERDEX_CONFIGURED_LAUNCHPAD_PROOF=

# Optional existing canonical pools. Use deployed COTI PrivateERC20-compatible tokens only.
COTI_POOL=
# Required with COTI_POOL; otherwise leave both unset so the scenario creates
# a disposable pair from the verified source and compatible private tokens.
COTI_QUOTE_POOL=
COTI_TEST_AMOUNT_IN=
# Optional raw-unit amount for the cross-contract GT best-execution gate.
COTI_BEST_EXECUTION_TEST_AMOUNT_IN=
# Optional raw-unit best-execution amounts. They are asset-specific because
# token decimals may differ; each value is capped by the runner.
# Optional maximum protocol-fee budget, in raw units, for each token across the
# complete funded scenario. Unset values use the runner's conservative cap.
COTI_TOKEN0=
COTI_TOKEN1=
COTI_TOKEN0_DECIMALS=18
COTI_TOKEN1_DECIMALS=18
COTI_FEE_BPS=30
COTI_QUOTE_FEE_BPS=100
COTI_LIQUIDITY_AMOUNT0=
COTI_LIQUIDITY_AMOUNT1=
COTI_QUOTE_LIQUIDITY_AMOUNT0=
COTI_QUOTE_LIQUIDITY_AMOUNT1=
COTI_SECOND_LP_AMOUNT0=
COTI_SECOND_LP_AMOUNT1=
COTI_SWAP_AMOUNT0=
COTI_SWAP_AMOUNT1=
# Required nonzero encrypted LP-withdrawal minima. Set these from the reviewed
# disposable scenario amounts; they are never inferred from public reserves.
COTI_SECOND_LP_REMOVE_MIN0=
COTI_SECOND_LP_REMOVE_MIN1=
COTI_PERSONAL_REMOVE_MIN0=
COTI_PERSONAL_REMOVE_MIN1=
COTI_FULL_EXIT_MIN0=
COTI_FULL_EXIT_MIN1=
# Maximum tolerated quote-to-execution movement in bps (default 100, max 5000).
COTI_TESTNET_SLIPPAGE_BPS=100
COTI_TEST_LOCK_SECONDS=10
COTI_LAUNCHPAD_FEE_BPS=30
# Optional raw-unit launchpad test amounts. Defaults to 0.001 token per side.
COTI_LAUNCHPAD_MIN_SHARES=
COTI_LAUNCHPAD_MIN_PRICE_X18=
COTI_LAUNCHPAD_MAX_PRICE_X18=
# Optional: 0=creator-held (default), 1=timed lock, 2=permanent lock.
COTI_LAUNCHPAD_DISPOSITION=
# Required only for disposition 1; use an absolute future Unix timestamp.
COTI_LAUNCHPAD_UNLOCK_TIME=
# Optional mature confidential fee-collection test (raw token units).
COTI_FEE_COLLECTION_POOL=
COTI_FEE_TEST_LIQUIDITY0=
COTI_FEE_TEST_LIQUIDITY1=
COTI_FEE_TEST_SWAP0=
COTI_FEE_TEST_SWAP1=
